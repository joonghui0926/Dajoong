{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dajoong-plan2bim-studio-web",
  "main": "studio-web-worker.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "dajoongbim.com", "custom_domain": true },
    { "pattern": "www.dajoongbim.com", "custom_domain": true },
    { "pattern": "studio.dajoongbim.com", "custom_domain": true },
    { "pattern": "app.dajoongbim.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "../../frontend/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}

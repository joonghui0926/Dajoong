# Local development uses http://127.0.0.1:8042 when this value is omitted.
# Production defaults to, and only accepts, the BU iLI-owned conversion API.
# Native builds use the same HTTPS API. Users cannot select another inference server.
VITE_STUDIO_API_URL=

# Cognito OpenID Connect. Leave empty for local development.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=

# Native OAuth uses the system browser and these registered app schemes.
VITE_NATIVE_REDIRECT_URI=com.dajoong.plan2bim://auth/callback
VITE_NATIVE_LOGOUT_URI=com.dajoong.plan2bim://auth/logout

# Set each flag only after its Cognito provider has been configured.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_KAKAO_ENABLED=false

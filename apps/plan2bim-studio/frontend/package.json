{
  "name": "@dajoong/plan2bim-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-release-bundle.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run store:validate",
    "links:prepare": "node scripts/prepare-app-links.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "store:screenshots": "npm run build && node scripts/capture-store-screenshots.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "review:screenshots": "node scripts/capture-product-review.mjs",
    "review:screenshots:auth": "node scripts/capture-product-review.mjs --auth-only",
    "store:validate": "node scripts/validate-store-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tosspayments/tosspayments-sdk": "^2.7.1",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.28.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}

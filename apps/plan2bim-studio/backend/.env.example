DAJOONG_RUNTIME=local
DAJOONG_STUDIO_DATA=./.data/jobs
DAJOONG_STUDIO_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAJOONG_STUDIO_WORKERS=1
DAJOONG_REQUIRE_AUTH=false
DAJOONG_AUTH_ISSUER=
DAJOONG_AUTH_AUDIENCE=
# Production only: shared with the Cloudflare Studio API proxy. Generate at least 32 random bytes.
DAJOONG_ORIGIN_VERIFY_SECRET=

# Billing defaults: first drawing free, then per-drawing or a 31-day unlimited pass.
DAJOONG_PRICE_USD_CENTS=399
DAJOONG_PRICE_KRW=5000
DAJOONG_MONTHLY_PRICE_USD_CENTS=7900
DAJOONG_MONTHLY_PRICE_KRW=99000
DAJOONG_STRIPE_SECRET_KEY=
DAJOONG_STRIPE_WEBHOOK_SECRET=
DAJOONG_TOSS_CLIENT_KEY=
DAJOONG_TOSS_SECRET_KEY=

# AWS runtime
AWS_REGION=us-west-2
DAJOONG_ARTIFACT_BUCKET=
DAJOONG_JOB_TABLE=
DAJOONG_JOB_QUEUE_URL=
DAJOONG_BILLING_TABLE=
DAJOONG_COLLABORATION_TABLE=
DAJOONG_GLOBAL_PROGRAM_MODEL_PATH=
DAJOONG_LOCAL_ELEMENT_MODEL_PATH=
DAJOONG_GLOBAL_PROGRAM_MODEL_S3_KEY=
DAJOONG_GLOBAL_PROGRAM_MODEL_SHA256=
DAJOONG_LOCAL_ELEMENT_MODEL_S3_KEY=
DAJOONG_LOCAL_ELEMENT_MODEL_SHA256=

# Company workspace invitation links and optional SES delivery.
DAJOONG_APP_URL=https://dajoongbim.com
DAJOONG_INVITE_FROM_EMAIL=

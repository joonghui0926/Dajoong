DAJOONG_RUNTIME=local
DAJOONG_STUDIO_DATA=./.data/jobs
DAJOONG_STUDIO_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAJOONG_STUDIO_WORKERS=1
